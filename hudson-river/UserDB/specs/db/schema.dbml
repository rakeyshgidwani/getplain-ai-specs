///////////////////////////////////////////////////////////////
// Plain UserDB Schema (PostgreSQL)
// Core user identity, linked providers, preferences, and sessions
// DBML 5.1.0 compatible
///////////////////////////////////////////////////////////////

Project plain_user_db {
  database_type: "PostgreSQL"
  Note: '''
  Plain developer platform - User Database.
  Handles user profiles, linked identities (OAuth providers),
  preferences, and session management.
  Uses actor_key pattern for external auth integration.
  @hudson.api.auth.provider("external-jwt")
  @hudson.api.auth.default("required")
  '''
}

///////////////////////////////////////////////////////////////
// Enums
///////////////////////////////////////////////////////////////

Enum identity_provider {
  github
  google
  gitlab
  bitbucket
  microsoft
  email
}

Enum account_status {
  active
  suspended
  deactivated
  pending_verification
}

Enum theme_preference {
  light
  dark
  system
}

Enum notification_frequency {
  realtime
  daily_digest
  weekly_digest
  none
}

///////////////////////////////////////////////////////////////
// Core User Profile
///////////////////////////////////////////////////////////////

Table user_profiles {
  id uuid [pk, default: `gen_random_uuid()`]
  actor_key varchar(128) [not null, unique, note: 'External auth system identifier (Clerk, Auth0, etc.)']
  handle varchar(40) [not null, unique, note: 'Unique @mention handle, lowercase alphanumeric with hyphens']
  display_name varchar(160) [not null]
  email varchar(255) [not null]
  email_verified_at timestamptz
  avatar_url text
  bio text [note: 'User bio/about, max 500 chars recommended']
  status account_status [not null, default: 'pending_verification']
  timezone varchar(64) [default: 'UTC', note: 'IANA timezone identifier']
  locale varchar(10) [default: 'en_US']
  last_seen_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Indexes {
    actor_key [unique]
    handle [unique]
    email
    `lower(handle)` [name: 'idx_user_profiles_handle_ci']
    `lower(email)` [name: 'idx_user_profiles_email_ci']
    status
    last_seen_at
  }

  Note: '''
  Core user profile. Links to external auth via actor_key.
  Handle is used for @mentions and must be unique, URL-safe.
  @hudson.api.resource: users
  '''
}

///////////////////////////////////////////////////////////////
// Linked Identities (OAuth Providers)
///////////////////////////////////////////////////////////////

Table user_identities {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  provider identity_provider [not null]
  provider_user_id varchar(255) [not null, note: 'User ID from the OAuth provider']
  provider_username varchar(255) [note: 'Username at the provider (e.g., GitHub username)']
  provider_email varchar(255)
  provider_avatar_url text
  access_token_encrypted text [note: 'Encrypted OAuth access token']
  refresh_token_encrypted text [note: 'Encrypted OAuth refresh token']
  token_expires_at timestamptz
  scopes jsonb [note: 'OAuth scopes granted as JSON array']
  raw_profile jsonb [note: 'Raw profile data from provider']
  linked_at timestamptz [not null, default: `now()`]
  last_used_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  Indexes {
    user_id
    (provider, provider_user_id) [unique, note: 'One identity per provider per user']
    provider
    last_used_at
  }

  Note: '''
  Linked OAuth identities. One user can connect multiple providers.
  Tokens are stored encrypted for API access to provider services.
  @hudson.api.resource: user-identities
  '''
}

Ref: user_identities.user_id > user_profiles.id

///////////////////////////////////////////////////////////////
// User Preferences
///////////////////////////////////////////////////////////////

Table user_preferences {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, unique]
  theme theme_preference [not null, default: 'system']
  notification_email notification_frequency [not null, default: 'realtime']
  notification_in_app notification_frequency [not null, default: 'realtime']
  notification_mentions boolean [not null, default: true]
  notification_updates boolean [not null, default: true]
  notification_marketing boolean [not null, default: false]
  keyboard_shortcuts_enabled boolean [not null, default: true]
  compact_mode boolean [not null, default: false]
  show_avatars boolean [not null, default: true]
  default_project_view varchar(32) [default: 'board', note: 'board, list, timeline, etc.']
  custom_preferences jsonb [default: '{}', note: 'Extensible preferences storage']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    user_id [unique]
  }

  Note: '''
  User preferences and settings. One record per user.
  custom_preferences JSONB allows flexible extension.
  @hudson.api.resource: user-preferences
  '''
}

Ref: user_preferences.user_id > user_profiles.id

///////////////////////////////////////////////////////////////
// User Sessions
///////////////////////////////////////////////////////////////

Table user_sessions {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  session_token_hash varchar(128) [not null, unique, note: 'SHA-256 hash of session token']
  ip_address inet [note: 'Client IP address']
  user_agent text [note: 'Browser/client user agent string']
  device_type varchar(32) [note: 'desktop, mobile, tablet, api']
  device_name varchar(160) [note: 'Friendly device name if available']
  device_fingerprint varchar(128) [note: 'Optional device fingerprint for recognition']
  location_country varchar(2) [note: 'ISO 3166-1 alpha-2 country code']
  location_city varchar(100)
  last_active_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]
  revoked_at timestamptz [note: 'Set when session is explicitly revoked']
  revocation_reason varchar(100) [note: 'user_initiated, security, admin, password_change']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    user_id
    session_token_hash [unique]
    expires_at
    (user_id, revoked_at) [note: 'Find active sessions for a user']
    last_active_at
  }

  Note: '''
  Active and historical user sessions.
  Enables "view active sessions", "sign out all devices", and security audit.
  Never store plaintext session tokens - only hashes.
  @hudson.api.resource: user-sessions
  '''
}

Ref: user_sessions.user_id > user_profiles.id

///////////////////////////////////////////////////////////////
// Handle Reservation (Optional - for reserved/blocked handles)
///////////////////////////////////////////////////////////////

Table reserved_handles {
  id uuid [pk, default: `gen_random_uuid()`]
  handle varchar(40) [not null, unique]
  reason varchar(255) [note: 'reserved, offensive, trademark, system']
  reserved_by varchar(128) [note: 'Admin actor_key who reserved it']
  reserved_until timestamptz [note: 'Null = permanent reservation']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    handle [unique]
    `lower(handle)` [name: 'idx_reserved_handles_ci']
  }

  Note: '''
  Reserved or blocked handles that cannot be claimed.
  Used for system handles (@admin, @support), offensive terms, or trademarks.
  '''
}
